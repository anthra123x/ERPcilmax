{
  "name": "erpcilmax",
  "version": "0.1.0",
  "description": "Tecnicell ERP / ERP Cilmax - Sistema integral de gestión de inventario, punto de venta (POS), finanzas, catálogo web y asistente IA",
  "repository": {
    "type": "git",
    "url": "https://github.com/anthra123x/ERPcilmax.git"
  },
  "private": true,
  "scripts": {
    "dev": "NEXT_TEST_WASM=1 SENTRY_SUPPRESS_INSTRUMENTATION_FILE_WARNING=1 bash scripts/with-node.sh next dev --webpack",
    "dev:node": "npm run dev",
    "build": "bash scripts/with-node.sh bash -c 'prisma generate && NEXT_TEST_WASM=1 next build --webpack'",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bash scripts/with-node.sh node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "bash scripts/with-node.sh node ./node_modules/vitest/vitest.mjs",
    "db:push": "bash scripts/with-node.sh node --env-file=.env.local node_modules/prisma/build/index.js db push",
    "db:migrate": "bash scripts/with-node.sh node --env-file=.env.local node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "bash scripts/with-node.sh node --env-file=.env.local node_modules/prisma/build/index.js migrate deploy",
    "db:status": "bash scripts/with-node.sh node --env-file=.env.local node_modules/prisma/build/index.js migrate status",
    "db:studio": "bash scripts/with-node.sh node --env-file=.env.local node_modules/prisma/build/index.js studio",
    "db:seed": "bash scripts/with-node.sh node --env-file=.env.local --import tsx prisma/seed.ts",
    "web:import": "bash scripts/with-node.sh node --env-file=.env.local --import tsx prisma/web-import.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@next/swc-wasm-nodejs": "^16.2.3",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.102.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.7.0",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "recharts": "^3.9.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agent-browser": "^0.35.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.3",
    "shadcn": "^4.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^54.4.1",
    "vitest": "^4.1.7"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "@sentry/cli@2.58.6": true,
    "esbuild@0.27.0": true,
    "msw@2.13.2": true,
    "prisma@5.22.0": true,
    "agent-browser@0.35.2": true,
    "unrs-resolver@1.11.1": true
  }
}
